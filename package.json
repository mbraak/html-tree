{
  "name": "html-tree",
  "version": "0.1.0",
  "description": "Tree widget in plain javascript",
  "keywords": [
    "tree"
  ],
  "license": "Apache-2.0",
  "browser": "./html_tree.js",
  "main": "./html_tree.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./html_tree.js"
    },
    "./html_tree.css": "./html_tree.css",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "html_tree.css",
    "html_tree.debug.js",
    "html_tree.debug.js.map",
    "html_tree.js",
    "html_tree.js.map",
    "lib",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbraak/html-tree.git"
  },
  "scripts": {
    "ci": "pnpm lint && pnpm tsc && pnpm test",
    "vitest": "vitest run --coverage --config test/vitest.config.mjs",
    "vitest-watch": "vitest --config test/vitest.config.mjs",
    "lint": "eslint config src playwright test",
    "production": "./config/production",
    "devserver": "SERVE=true rollup --config config/rollup.config.mjs --watch",
    "devserver-with-coverage": "COVERAGE=true SERVE=true rollup --config config/rollup.config.mjs",
    "build-with-coverage": "COVERAGE=true rollup --config config/rollup.config.mjs",
    "prettier": "prettier src/*.ts --write --tab-width 4",
    "tsc": "tsc --noEmit --project tsconfig.json",
    "version": "node config/generateVersion.mjs && git add src/version.ts",
    "playwright": "pnpm build-with-coverage && playwright test --config playwright/playwright.config.js",
    "test": "pnpm vitest && pnpm playwright"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@cspell/eslint-plugin": "^10.0.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/debug": "^4.1.13",
    "@types/node": "^26.1.1",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.24",
    "autoprefixer": "^10.5.4",
    "axe-core": "^4.12.1",
    "babel-plugin-istanbul": "^8.0.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jest-extended": "^3.0.1",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-playwright": "^2.10.5",
    "eslint-plugin-testing-library": "^7.16.2",
    "jest-extended": "^7.0.0",
    "jsdom": "^29.1.1",
    "jsdom-testing-mocks": "^1.16.0",
    "jsonfile": "^6.2.1",
    "lodash": "^4.18.1",
    "msw": "^2.15.0",
    "postcss": "^8.5.23",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "postcss-load-config": "^6.0.1",
    "postcss-nested": "^7.0.2",
    "prettier": "^3.9.6",
    "rollup": "^4.62.2",
    "rollup-plugin-serve": "^3.0.0",
    "rollup-plugin-tsconfig-paths": "^1.5.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
