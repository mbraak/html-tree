{
    "$schema": "https://typedoc-plugin-markdown.org/schema.json",
    "entryPoints": ["config/typedocEntry.ts"],
    "plugin": ["typedoc-plugin-markdown"],
    "out": "docs/reference/generated",
    "readme": "none",
    "disableSources": true,
    "excludePrivate": true,
    "hideBreadcrumbs": true,
    "hidePageHeader": true,
    "hidePageTitle": true,
    "parametersFormat": "table",
    "interfacePropertiesFormat": "list",
    "propertyMembersFormat": "table",
    "useCodeBlocks": true,
    "expandParameters": false,
    "sort": ["source-order"],
    "groupOrder": [
        "Lifecycle",
        "Finding nodes",
        "Mouse",
        "Data",
        "Appearance",
        "Opening and closing",
        "Selection",
        "Changing the tree",
        "Drag and drop",
        "Loading data",
        "State",
        "Other",
        "Advanced"
    ],
    "validation": {
        "notExported": false
    }
}
